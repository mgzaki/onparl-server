# AWS Credentials for Production SMS
# Copy this file to the server deployment environment
# DO NOT commit to git!

# AWS credentials for SNS SMS service
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-east-1

# Application mode
SMS_MOCK_ENABLED=false  # Set to false for production, true for development

# AWS S3 Configuration for Profile Pictures
AWS_S3_BUCKET_NAME=onparl-profile-pictures-prod
